# Everything here is optional with the bundled docker-compose.yml.

# Netatmo credentials can be entered on the web page on first start instead.
# NETATMO_CLIENT_ID=
# NETATMO_CLIENT_SECRET=
# NETATMO_REFRESH_TOKEN=

# Password for the bundled Postgres container (set it before the first start)
# POSTGRES_PASSWORD=netatmo
# Or use your own Postgres instead of the bundled one:
# DATABASE_URL=postgres://user:password@host:5432/netatmo

# Optional
# PORT=8080
# POLL_SECONDS=300
# DEMO=1   # serve fake data, no Netatmo account needed
