# From https://dev.netatmo.com/apps -> your app
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
# Generate with the "Token generator" on the app page, scope: read_station.
# Only needed for the first start; the rotated token is then kept in /data/tokens.json.
NETATMO_REFRESH_TOKEN=

# Optional
# PORT=8080
# POLL_SECONDS=300
# DEMO=1   # serve fake data, no Netatmo account needed
